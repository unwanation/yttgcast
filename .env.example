# --- Telegram MTProto user API (https://my.telegram.org/apps) -- required ---
TG_API_ID=
TG_API_HASH=
# Phone in international format; only used by the one-time auth command (it prompts if empty).
TG_PHONE=
# Optional: base64 session printed by the auth command. Seeds data/session.json when that
# file does not exist (lets you move the daemon to another host without re-logging in).
TG_SESSION_STRING=

# --- Polling ---
# Seconds between feed polls (default 900 = 15 min; 86400 = once a day). Minimum 60.
POLL_INTERVAL_SECONDS=900
# On the very first run, process only the newest N videos and mark the rest as seen (default 1, 0 = none).
INITIAL_BACKLOG=1
# Give up on a video after this many failed attempts (default 10).
MAX_ATTEMPTS=10

# --- YouTube / audio ---
# Channel to watch -- required. The "UC..." id (channel page -> About -> Share channel -> Copy channel ID).
# Example: Theo (@t3dotgg)
YT_CHANNEL_ID=UCbRP3c757lWg9M-U7TyEkXA
# Optional: channel URL for the yt-dlp fallback (default: https://www.youtube.com/channel/<YT_CHANNEL_ID>/videos)
#YT_CHANNEL_URL=https://www.youtube.com/@t3dotgg/videos
# m4a | mp3
AUDIO_FORMAT=m4a
# Optional: performer tag shown in Telegram (default: the YouTube channel name)
#AUDIO_PERFORMER=Theo - t3.gg
DOWNLOAD_TIMEOUT_SECONDS=3600
# run `yt-dlp -U` at start and daily
YTDLP_AUTO_UPDATE=true
# If YouTube answers "Sign in to confirm you're not a bot", export cookies (Netscape format)
# from a logged-in browser to data/cookies.txt and set:
#YTDLP_COOKIES_FILE=/data/cookies.txt
#YTDLP_EXTRA_ARGS=

# --- Logging ---
# debug | info | warn | error
LOG_LEVEL=info
# json | text
LOG_FORMAT=json
